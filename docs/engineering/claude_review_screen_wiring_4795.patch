diff --git a/tests/test_guided_review_recalculation_screen_v1.py b/tests/test_guided_review_recalculation_screen_v1.py
new file mode 100644
index 000000000..d3dcb23a3
--- /dev/null
+++ b/tests/test_guided_review_recalculation_screen_v1.py
@@ -0,0 +1,84 @@
+"""The guided review screen recalculates the rooms with a saved correction (runs the real Streamlit script runner).
+
+Synthetic PDF and a minimal local database only.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import sqlite3
+
+import pytest
+
+import pb_guided_plan_review as review
+import pb_new_source_trace_preview as canonical
+from tests.test_user_assisted_review_topology_v1 import _missing_wall_room, _pdf
+
+AppTest = pytest.importorskip("streamlit.testing.v1").AppTest
+
+SCRIPT = '''
+import json, sqlite3
+import streamlit as st
+from pb_guided_plan_review_ui import render_guided_plan_review
+
+cfg = json.loads(open({config!r}, encoding="utf-8").read())
+
+
+def connect():
+    conn = sqlite3.connect(cfg["db"])
+    conn.row_factory = sqlite3.Row
+    return conn
+
+
+summary = json.loads(open(cfg["summary"], encoding="utf-8").read())
+png = open(cfg["png"], "rb").read()
+render_guided_plan_review(
+    st, workspace={{"id": 1}}, page={{"id": 1, "page_no": 1, "scale_verified": 0}},
+    native_trace={{"digest": cfg["sha"], "summary": summary, "png": png}}, doc_path=cfg["pdf"],
+    registered_sha=cfg["sha"], connect=connect, line_editor=None)
+'''
+
+
+def _setup(tmp_path):
+    pdf = _pdf(tmp_path / "missing.pdf", _missing_wall_room())
+    sha = hashlib.sha256(pdf.read_bytes()).hexdigest()
+    summary, png = canonical.source_native_trace_preview(pdf, 0)
+    db = tmp_path / "local.db"
+    with sqlite3.connect(db) as conn:
+        conn.executescript(
+            "CREATE TABLE workspaces(id INTEGER PRIMARY KEY);"
+            "CREATE TABLE documents(id INTEGER PRIMARY KEY, workspace_id INTEGER, sha256 TEXT);"
+            "CREATE TABLE pages(id INTEGER PRIMARY KEY, workspace_id INTEGER, document_id INTEGER, page_no INTEGER);"
+            "INSERT INTO workspaces VALUES (1);"
+            f"INSERT INTO documents VALUES (1, 1, '{sha}');"
+            "INSERT INTO pages VALUES (1, 1, 1, 1);")
+    scope = review.ReviewScope(1, 1, 1, sha, hashlib.sha256(png).hexdigest())
+    wall = {"id": "w1", "takeoff_row_id": 2, "kind": "line", "x1": 31.8, "y1": 70.571, "x2": 38.2, "y2": 70.571}
+
+    def connect():
+        conn = sqlite3.connect(db)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    review.save_review(connect, scope, expected_revision=0, shapes=[wall], answers={})
+    (tmp_path / "summary.json").write_text(json.dumps(summary), encoding="utf-8")
+    (tmp_path / "overlay.png").write_bytes(png)
+    config = tmp_path / "config.json"
+    config.write_text(json.dumps({"db": str(db), "pdf": str(pdf), "sha": sha, "png": str(tmp_path / "overlay.png"),
+                                  "summary": str(tmp_path / "summary.json")}), encoding="utf-8")
+    return AppTest.from_string(SCRIPT.format(config=str(config)), default_timeout=120)
+
+
+def _recalculate_button(app):
+    return next(button for button in app.button if button.label == "Recalculate rooms")
+
+
+def test_the_button_recalculates_with_the_saved_correction_and_keeps_the_result(tmp_path):
+    app = _setup(tmp_path).run()
+    assert not app.exception
+    assert not any("Rooms:" in info.value for info in app.info)  # nothing is recalculated until asked
+    _recalculate_button(app).click().run()
+    assert not app.exception and not app.error
+    assert any("Rooms: 0 automatic, 1 with your corrections" in info.value for info in app.info)
+    app.run()  # a plain rerun shows the kept result without recalculating
+    assert any("Rooms: 0 automatic, 1 with your corrections" in info.value for info in app.info)
